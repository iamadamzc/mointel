[Unit]
# One watchdog tick (deploy/aws/watchdog.sh). Started by mointel-watchdog.timer
# every minute; deliberately NOT part of mointel.target, so a deploy never
# stops it and it never starts the market worker.
Description=Momentum Intelligence — watchdog tick
After=network-online.target

[Service]
Type=oneshot
User=mointel
Group=mointel
StateDirectory=mointel-watchdog
Environment=WATCHDOG_STATE_DIR=/var/lib/mointel-watchdog
ExecStart=/bin/bash /opt/mointel/current/deploy/aws/watchdog.sh
TimeoutStartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mointel-watchdog

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
