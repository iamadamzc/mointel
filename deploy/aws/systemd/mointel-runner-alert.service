[Unit]
# One runner-alert tick (deploy/aws/runner-alert.sh). Started by
# mointel-runner-alert.timer every minute; NOT part of mointel.target, so a
# deploy never stops it. deploy.sh installs this unit but does NOT enable the
# timer: it is enabled by hand, on his word, once the two settings below are his.
Description=Momentum Intelligence: runner alert tick
After=network-online.target

[Service]
Type=oneshot
User=mointel
Group=mointel
StateDirectory=mointel-runner-alert
Environment=RUNNER_STATE_DIR=/var/lib/mointel-runner-alert
# HIS SETTINGS (put to him by Integration 32nd, 2026-10-06; these are the
# recommended values until he answers):
#   prior = % from the prior day's close all day; stored = the stored percent.
Environment=RUNNER_BASELINE=prior
#   prior = the 1-10 band applies to the prior close; current = to the price now.
Environment=RUNNER_BAND_ON=prior
ExecStart=/bin/bash /opt/mointel/current/deploy/aws/runner-alert.sh
TimeoutStartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mointel-runner-alert

NoNewPrivileges=yes
PrivateTmp=yes
# FULL, not STRICT as the watchdog uses: a SQLite reader on a WAL database may
# need to write market.db-shm under /var/lib/mointel; strict would make that
# read-only. /usr, /boot and /etc stay read-only.
ProtectSystem=full
ProtectHome=yes
