# Momentum Intelligence Trading Desk - environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real credentials.

# ---------------------------------------------------------------- research
# With no Google credentials set, the app automatically runs in mock mode.

# The Trading Desk spreadsheet ID (the long id in the sheet URL).
GOOGLE_SHEET_ID=1YfuAbKH80aSJFLdpEHYZNMa15jew3fMkhVeaJQbUztQ

# Service-account email, e.g. trading-desk@my-project.iam.gserviceaccount.com
# The spreadsheet must be shared with this address as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service-account private key from the downloaded JSON key file.
# Keep it on ONE line, wrapped in double quotes, with literal \n escapes:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Optional: force the built-in mock research dataset even when credentials exist.
# USE_MOCK_DATA=true

# ------------------------------------------------------------------ market
# Read ONLY by the market worker; the Next.js process never loads these.
# They may also be supplied in a root-level text file (see README).

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=sip

# ------------------------------------------------------------- discovery
# RVOL_DISCOVERY_RANK=12          # trader-facing Top N
# RVOL_INTERNAL_RANK=50           # internal high-resolution candidate count
# DISCOVERY_PRICE_MIN=1
# DISCOVERY_PRICE_MAX=20
# RVOL_BASELINE_SESSIONS=20

# ----------------------------------------------------------------- runtime
# MARKET_DB_PATH=data/market.db
# MARKET_FLUSH_INTERVAL_MS=1000
# MARKET_CLIENT_POLL_MS=1000
# MARKET_HEARTBEAT_STALE_MS=15000
# MARKET_TICKER_STALE_SECONDS=300
# MARKET_MINUTE_BAR_RETENTION_DAYS=3
# ALPACA_REST_BATCH_SIZE=200
# ALPACA_REST_CONCURRENCY=4
# ALPACA_DEBUG=0
# MOINTEL_DASHBOARD_URL=http://localhost:3000

# Diagnostics only: reconstruct a specific completed session outside market
# hours. Never set this during a live trading session.
# DEMAND_TRADING_DATE_OVERRIDE=2026-08-14
