# Momentum Intelligence Trading Desk - environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real credentials.

# ---------------------------------------------------------------- research
# With no Google credentials set, the app automatically runs in mock mode.

# The Trading Desk spreadsheet ID (the long id in the sheet URL).
GOOGLE_SHEET_ID=1YfuAbKH80aSJFLdpEHYZNMa15jew3fMkhVeaJQbUztQ

# Service-account email, e.g. trading-desk@my-project.iam.gserviceaccount.com
# The spreadsheet must be shared with this address as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service-account private key from the downloaded JSON key file.
# Keep it on ONE line, wrapped in double quotes, with literal \n escapes:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=


# ------------------------------------------------------------------ market
# Read ONLY by the market worker; the Next.js process never loads these.
# They may also be supplied in a root-level text file (see README).

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=sip

# ------------------------------------------------------------- discovery
# RVOL_DISCOVERY_RANK=12          # trader-facing Top N
# RVOL_INTERNAL_RANK=50           # internal high-resolution candidate count
# DISCOVERY_PRICE_MIN=1
# DISCOVERY_PRICE_MAX=20
# RVOL_BASELINE_SESSIONS=20

# ----------------------------------------------------------------- runtime
# MARKET_DB_PATH=data/market.db
# MARKET_FLUSH_INTERVAL_MS=1000
# MARKET_CLIENT_POLL_MS=1000
# MARKET_HEARTBEAT_STALE_MS=15000
# MARKET_TICKER_STALE_SECONDS=300
# MARKET_MINUTE_BAR_RETENTION_DAYS=20
# ALPACA_REST_BATCH_SIZE=200
# ALPACA_REST_CONCURRENCY=4
# ALPACA_DEBUG=0
# MOINTEL_DASHBOARD_URL=http://localhost:3000

# Diagnostics only: reconstruct a specific completed session outside market
# hours. Never set this during a live trading session.
# DEMAND_TRADING_DATE_OVERRIDE=2026-08-14

# ------------------------------------------------- automatic public research
# Read ONLY by the research worker. The Next.js process never loads these.

# SEC requires a real contact address identifying the requester. There is no
# default and no fallback: without this, automated SEC fetching is disabled and
# the diagnostic says so, rather than sending an anonymous bot at their servers.
SEC_USER_AGENT=Momentum Intelligence Trading Desk contact@example.com

# SEC publishes a 10 req/s ceiling. We stay well under it, globally across all
# concurrent research jobs — not per job.
# SEC_MAX_REQUESTS_PER_SECOND=5

# Filing-metadata poll interval for the small active research population only.
# This is not a market-wide crawl.
# SEC_ACTIVE_POLL_SECONDS=60

# Interpretation layer. Optional: with no key the worker still resolves CIKs,
# collects filings and stores sources; only interpretation is unavailable.
# Classifications are never fabricated to fill the gap.
OPENAI_API_KEY=

# Default full research/interpreter model. Read in exactly one place
# (the interpreter factory); nothing else in the codebase names a model.
OPENAI_RESEARCH_MODEL=gpt-5.6-terra

# Optional tier overrides. Both fall back to OPENAI_RESEARCH_MODEL when unset,
# so the tiering is an optimisation, never a requirement.
#
# Escalation model for dossiers the default tier flags as difficult or where
# SHEET and AUTO materially conflict.
# OPENAI_ESCALATION_MODEL=gpt-5.6-sol
#
# Cheap model for evidence-change detection during periodic catalyst refresh.
# This tier decides only "has the evidence changed?" — it never classifies.
# OPENAI_CHANGE_DETECT_MODEL=gpt-5.6-luna

# Any ticker entering the live Top N is eligible for automatic research.
# RESEARCH_AUTO_RANK=12
# RESEARCH_CONCURRENCY=2
# CATALYST_REFRESH_MINUTES=10

# ------------------------------------------------------- catalyst collection
# Deterministic known-source polling: SEC filings, exhibits and company feeds.
# Costs a network request and no model call, so it runs often.
# CATALYST_SOURCE_POLL_SECONDS=60

# How often a currently relevant ticker may run a low-cost source-discovery
# check. A press release can cross a newswire without touching SEC submissions
# or a company feed, so an unchanged local fingerprint does not prove nothing
# happened — elapsed time may therefore trigger a bounded check on the cheap
# tier. It never triggers interpretation.
#
# Unresolved: no recent source located, or coverage incomplete.
# CATALYST_WEB_DISCOVERY_UNRESOLVED_MINUTES=10
# Resolved: a recent canonical source is already established.
# CATALYST_WEB_DISCOVERY_RESOLVED_MINUTES=30

# How recent a source must be to bear on current attention, and how far back
# sources are collected for context so recycled news stays recognisable.
# CATALYST_ACTIVE_FRESHNESS_HOURS=36
# CATALYST_CONTEXT_LOOKBACK_DAYS=45

# ------------------------------------------------------------ cycle history
# Split-adjusted daily sessions cached for momentum-cycle context.
#
# Deliberately separate from MARKET_MINUTE_BAR_RETENTION_DAYS: live state needs
# minutes, cycle classification needs months, and widening the minute retention
# to serve cycle history would grow the hot path to solve a cold-path problem.
# CYCLE_HISTORY_TRADING_DAYS=90
