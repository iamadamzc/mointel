# Momentum Intelligence Trading Desk - environment template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real credentials.
#
# With no credentials set, the app automatically runs in mock mode.

# The Trading Desk spreadsheet ID (the long id in the sheet URL).
GOOGLE_SHEET_ID=1YfuAbKH80aSJFLdpEHYZNMa15jew3fMkhVeaJQbUztQ

# Service-account email, e.g. trading-desk@my-project.iam.gserviceaccount.com
# The spreadsheet must be shared with this address as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service-account private key from the downloaded JSON key file.
# Keep it on ONE line, wrapped in double quotes, with literal \n escapes:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# Optional: force the built-in mock dataset even when credentials are present.
# USE_MOCK_DATA=true
