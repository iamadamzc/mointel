{
  "name": "mointel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "desk": "node scripts/desk.mjs",
    "migrate": "tsx worker/migrate.ts",
    "review:create": "tsx --conditions=react-server worker/review.ts create",
    "review:list": "tsx --conditions=react-server worker/review.ts list",
    "review:revoke": "tsx --conditions=react-server worker/review.ts revoke",
    "review:revoke-all": "tsx --conditions=react-server worker/review.ts revoke-all",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "market:alpaca": "tsx worker/alpaca.ts",
    "market:sim": "tsx worker/simulator.ts",
    "market:test": "tsx worker/test-stream.ts",
    "market:diagnose": "tsx worker/diagnose.ts",
    "market:baseline": "tsx worker/baseline.ts",
    "market:recover-bars": "tsx worker/minute-bar-recovery.ts",
    "assessments": "tsx worker/desk-assessments.ts",
    "research": "tsx worker/research.ts",
    "research:collect": "tsx --conditions=react-server worker/research-collect.ts",
    "research:catalyst": "tsx --conditions=react-server worker/research-catalyst.ts",
    "research:interpret": "tsx --conditions=react-server worker/research-interpret.ts",
    "research:diagnose": "tsx --conditions=react-server worker/research-diagnose.ts",
    "archive:backfill": "tsx worker/archive-backfill.ts",
    "archive:coverage": "tsx worker/archive-backfill.ts --coverage-only",
    "archive:export": "tsx worker/archive-export.ts",
    "research:replay": "tsx --conditions=react-server worker/research-replay.ts",
    "fills:import": "tsx worker/fills-import.ts",
    "fills:report": "tsx worker/fills-report.ts",
    "fills:rules": "tsx worker/fills-rules.ts",
    "fills:coverage": "tsx worker/fills-coverage.ts",
    "archive:scorecard": "tsx worker/scorecard.ts",
    "archive:dial": "tsx worker/dial.ts",
    "archive:revival": "tsx worker/revival.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "marked": "^15.0.12",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
