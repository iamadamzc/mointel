# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# google service account credentials (never commit)
*.json.key
/mointel-*.json
/service-account*.json
/credentials*.json
*-service-account.json

# local prompt/spec scratch
*.backup

# local agent session settings
.claude/settings.local.json

# alpaca / market credentials dropped as root-level text files
/*.txt
/alpaca*.env
/apca*

# local state store (market database) and logs
/data/
*.db
*.db-wal
*.db-shm
/logs/
