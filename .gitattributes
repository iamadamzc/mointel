# Line endings.
#
# Development happens on Windows; the desk runs on Linux. Git's default is to
# hand out CRLF on checkout here, which is fine for TypeScript and fatal for
# anything the server executes: a shell script with CRLF fails at the first line
# with `\r: command not found`, and a systemd unit with CRLF has a carriage
# return in every value it parses.
#
# So the files that cross the boundary are pinned to LF regardless of platform.

* text=auto

*.sh       text eol=lf
*.mjs      text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
*.target   text eol=lf

# Pre-registered defect sets: pinned to LF so their committed sha256 verifies on any
# checkout, on any platform (the hashes were computed over LF bytes).
docs/research/session-reports/defect-set.md text eol=lf
docs/research/session-reports/defect-set-2.md text eol=lf

